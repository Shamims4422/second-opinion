# SECONDOPINION_APPROVE_THRESHOLD=0.75
# SECONDOPINION_BLOCK_THRESHOLD=0.45
# SECONDOPINION_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
